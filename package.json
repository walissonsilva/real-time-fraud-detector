{
  "name": "real-time-fraud-detector",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de detecção de transações suspeitas em tempo real (CE 1)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "set -a; . ./.env; set +a; jest --config test/jest-e2e.config.js --runInBand",
    "migrate": "set -a; . ./.env; set +a; ts-node src/database/migrate.ts",
    "contracts:validate": "node docs/contratos/validate-contracts.mjs",
    "infra:up": "docker compose up -d --wait postgres redis localstack",
    "infra:down": "docker compose down -v",
    "test:int": "set -a; . ./.env; set +a; jest --config test/jest-int.config.js --runInBand",
    "load": "set -a; . ./.env; set +a; ts-node scripts/load-test.ts",
    "load:k6": "mkdir -p load/k6/results && docker run --rm -i --user \"$(id -u):$(id -g)\" --add-host=host.docker.internal:host-gateway -v \"$PWD/load/k6:/scripts:ro\" -v \"$PWD/load/k6/results:/results\" -e RATE -e DURATION_SECONDS -e DRAIN_SECONDS -e ALERT_RATE -e ACCOUNTS -e P95_MS -e P99_MS -e AWS_ENDPOINT=${AWS_ENDPOINT:-http://host.docker.internal:4566} grafana/k6:0.55.0 run /scripts/fraud-latency.js"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1147.0",
    "@aws-sdk/client-sqs": "^3.1147.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.service.ts",
      "**/*.types.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
