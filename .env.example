NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://fraud:fraud@localhost:55432/fraud
REDIS_URL=redis://localhost:6379

# LocalStack (SQS/SNS). Credenciais fictícias, válidas só para o ambiente local.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_TRANSACTIONS_QUEUE=transactions
SQS_TRANSACTIONS_DLQ=transactions-dlq
SNS_ALERTS_TOPIC=alerts.fifo

# Filas por canal e DLQs (topologia criada por infra/localstack/init-aws.sh)
SQS_CHANNEL_ANTIFRAUD_QUEUE=alert-deliveries-antifraud-queue.fifo
SQS_CHANNEL_CUSTOMER_QUEUE=alert-deliveries-customer-push.fifo
SQS_CHANNEL_ANTIFRAUD_DLQ=alert-deliveries-antifraud-queue-dlq.fifo
SQS_CHANNEL_CUSTOMER_DLQ=alert-deliveries-customer-push-dlq.fifo

# Regras stateless carregadas na inicialização (FR-014b: serviço não inicia se inválidas)
RULES_CONFIG_PATH=config/rules.json

# Outbox: publicação no SNS e relay de pendentes
SNS_PUBLISH_TIMEOUT_MS=2000
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_MIN_AGE_MS=2000
OUTBOX_RELAY_BATCH_SIZE=100

# Consumidores e relay (desligar com CONSUMERS_ENABLED=false, ex.: testes que sobem só o HTTP)
CONSUMERS_ENABLED=true
SQS_TRANSACTION_POLLERS=4

# Entrega por canal: timeout, retentativas com espera crescente e injeção de falha dos provedores simulados
SQS_CHANNEL_POLLERS=2
CHANNEL_DELIVERY_MAX_ATTEMPTS=3
CHANNEL_DELIVERY_BASE_DELAY_MS=200
CHANNEL_DELIVERY_MAX_DELAY_MS=2000
CHANNEL_SEND_TIMEOUT_MS=2000
CHANNEL_ANTIFRAUD_FAIL=false
CHANNEL_CUSTOMER_FAIL=false
# Desliga só os consumidores de canal (ex.: testes que leem as filas de canal diretamente)
CHANNEL_CONSUMERS_ENABLED=true
